<!-- Candle Glow Filter (add this inside <defs> if it exists, otherwise add it at the top) -->
<defs>
  <filter id="candleGlow" x="-50%" y="-50%" width="200%" height="200%">
    <feGaussianBlur stdDeviation="4" result="coloredBlur"/>
    <feMerge>
      <feMergeNode in="coloredBlur"/>
      <feMergeNode in="SourceGraphic"/>
    </feMerge>
  </filter>
</defs>

<!-- Candle Group (position these where you want the candles to appear) -->
<g id="candles">
  <!-- Candle 0 (Shamash - center candle) -->
  <g id="candle0" class="candle" transform="translate(200, 100)">
    <!-- Candle body -->
    <rect class="candle-body" x="-5" y="-40" width="10" height="40" rx="2" fill="#FFFFFF" stroke="#333" stroke-width="0.5"/>
    <!-- Flame (initially hidden) -->
    <g class="flame" display="none">
      <path d="M-4,-10 C-4,-20 4,-20 4,-10 C4,-15 -4,-15 -4,-10 Z" 
            fill="none" 
            stroke="none" 
            stroke-width="1.5"
            filter="url(#candleGlow)"/>
    </g>
  </g>

