# Build the static site using the prepared deps image
ARG DEPS_IMAGE=pxt-deps:latest
FROM ${DEPS_IMAGE}

WORKDIR /opt/work

# Optionally update to the latest pxt-atisa (branch selectable)
ARG ATISA_REF=staging
ARG REPO_NAME=pxt-atisa

RUN cd pxt-atisa \
    && git fetch origin \
    && git checkout ${ATISA_REF} \
    && git pull --ff-only origin ${ATISA_REF}

# Build static package and assert output exists
RUN cd pxt-atisa \
    && pxt staticpkg --route ${REPO_NAME} \
    && test -d built/packaged \
    && ls -lah built/packaged

# Extract files from the nested pxt-atisa directory to the root
RUN mkdir -p /out/site \
    && if [ -d "pxt-atisa/built/packaged/${REPO_NAME}" ]; then \
    cp -R pxt-atisa/built/packaged/${REPO_NAME}/. /out/site/; \
    else \
    cp -R pxt-atisa/built/packaged/. /out/site/; \
    fi

# Merge docs/static into /out/site/static (copy contents, not the folder itself)
RUN mkdir -p /out/site/static \
    && cp -R /out/site/docs/static/. /out/site/static/

# Debug: Show the final structure
RUN echo "=== Final site structure ===" \
    && ls -lah /out/site \
    && echo "=== /out/site/static ===" \
    && ls -lah /out/site/static || echo "No static directory"

# Show what we produced by default
CMD ["bash","-lc","ls -la /out/site && echo 'Output at /out/site'"]